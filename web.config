<?xml version="1.0" encoding="UTF-8"?>
<!--
  ticketclub.my - IIS configuration.

  The app is deployed "document-root" style (Laravel's public/ contents are
  served from the project root), which is the layout the Apache .htaccess
  assumes. IIS ignores .htaccess, so the same rules are expressed here as
  URL Rewrite rules. This file only affects the ticketclub.my site.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>

        <!-- 0. Leave certificate challenges alone so renewals keep working. -->
        <rule name="Allow ACME challenge" stopProcessing="true">
          <match url="^\.well-known/acme-challenge/.*$" ignoreCase="true" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- 1. Never expose the framework's private storage. -->
        <rule name="Block private storage" stopProcessing="true">
          <match url="^storage(/(logs|framework|app)(/.*)?)?/?$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>

        <!-- 2. Serve the public/ directory from the web root (mirrors .htaccess). -->
        <rule name="Map storage to public" stopProcessing="true">
          <match url="^storage/(.*)$" />
          <action type="Rewrite" url="public/storage/{R:1}" />
        </rule>

        <rule name="Map build assets to public" stopProcessing="true">
          <match url="^build/(.*)$" />
          <action type="Rewrite" url="public/build/{R:1}" />
        </rule>

        <rule name="Map images to public" stopProcessing="true">
          <match url="^images/(.*)$" />
          <action type="Rewrite" url="public/images/{R:1}" />
        </rule>

        <rule name="Map public root files" stopProcessing="true">
          <match url="^(favicon\.ico|robots\.txt|synergy\.png|ticketclub\.png|ticketclub-favicon\.ico)$" ignoreCase="true" />
          <action type="Rewrite" url="public/{R:0}" />
        </rule>

        <!-- 3. Keep application source, secrets and build tooling off the web. -->
        <rule name="Block application source directories" stopProcessing="true">
          <match url="^(vendor|node_modules|app|bootstrap|config|database|resources|routes|tests)/" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>

        <rule name="Block dotfiles" stopProcessing="true">
          <match url="^\." ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>

        <rule name="Block development files" stopProcessing="true">
          <match url="^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|phpunit\.result\.cache|postcss\.config\.cjs|tailwind\.config\.cjs|vite\.config\.js|worldcup)$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>

        <rule name="Block docs and data dumps" stopProcessing="true">
          <match url=".*\.(md|zip|sql|bak|log|sqlite|sqlite3|db|ini|sh|bat|ps1|lock)$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>

        <!-- 4. Everything else is handled by the Laravel front controller. -->
        <rule name="Laravel front controller" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>

      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
