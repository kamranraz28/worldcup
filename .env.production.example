APP_NAME="TicketClub"
APP_ENV=production
# Generate on the server with: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://ticketclub.my
ASSET_URL=https://ticketclub.my

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# cPanel MySQL credentials for ticketclub.my
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync = report exports & emails run instantly, no queue worker needed on shared hosting.
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Mailgun (transactional email)
MAIL_MAILER=mailgun
MAIL_FROM_ADDRESS="noreply@ticketclub.my"
MAIL_FROM_NAME="TicketClub"
MAILGUN_DOMAIN=ticketclub.my
MAILGUN_ENDPOINT=api.mailgun.net
MAILGUN_SECRET=

# Proxies in front of the origin (Cloudflare / cPanel reverse proxy) are trusted.
TRUSTED_PROXIES=*

# ShurjoPay payment gateway credentials (live).
SHURJOPAY_BASE_URL=https://engine.shurjopayment.com/api
SHURJOPAY_USERNAME=
SHURJOPAY_PASSWORD=
SHURJOPAY_PREFIX=TC

VITE_APP_NAME="${APP_NAME}"